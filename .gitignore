# AL build output
*.app

# Generated base translation file (regenerated on build); language files (e.g. *.es-ES.xlf) ARE versioned
Translations/*.g.xlf

# Downloaded symbol packages (large binaries, restored via AL: Download Symbols)
.alpackages/

# AL test runner artifacts
.altestrunner/

# AL language server cache (stale entries cause phantom IDE errors; rebuilt automatically)
.vscode/.alcache/

# AL/VS Code local artifacts
.snapshots/
rad.json
*.g.xml
